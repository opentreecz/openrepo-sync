# =============================================================================
# openrepo-sync — Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env && $EDITOR .env
#
# docker compose reads .env automatically. NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — OpenRepo API key
# ---------------------------------------------------------------------------
# Found in the OpenRepo web UI under your user profile, or via:
#   curl -s -H "Authorization: Token <key>" https://repo.example.com/api/whoami
#
# This value is expanded as ${OPENREPO_API_KEY} inside config.yaml.
OPENREPO_API_KEY=

# ---------------------------------------------------------------------------
# OpenRepo server / sync behaviour (substituted into config.yaml)
# ---------------------------------------------------------------------------
# config.yaml.example uses ${VAR:-default}: the default applies unless the
# variable is set here (or in the environment). A literal value written in
# your own config.yaml always wins, since it contains no placeholder.
#
# Base URL of the OpenRepo server, no trailing slash.
# OPENREPO_API_URL=https://openrepo.example.com
# Interval between scheduled sync passes (m = minutes, h = hours, d = days).
# OPENREPO_SYNC_INTERVAL=24h
# Enable the scheduler when started with --schedule (true/false).
# OPENREPO_SYNC_SCHEDULE_ENABLED=true
# Run one sync pass immediately at container start (true/false).
# OPENREPO_SYNC_RUN_ON_START=true
# Global architecture filter (amd64, arm64, armhf, i386).
# OPENREPO_SYNC_ARCH=amd64

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
# Image to run (pin a release tag for reproducible deployments).
# OPENREPO_SYNC_IMAGE=ghcr.io/opentreecz/openrepo-sync:latest
# Host paths mounted as /config.yaml and /projects.
# OPENREPO_SYNC_CONFIG=./config.yaml
# OPENREPO_SYNC_PROJECTS_DIR=./projects
# Container timezone (affects log timestamps only).
# TZ=UTC

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Optional tracing filter. Defaults to info, or debug with --verbose.
# Compose forwards RUST_LOG (default: info).
# RUST_LOG=info
# RUST_LOG=openrepo_sync=debug,reqwest=warn

# ---------------------------------------------------------------------------
# YAML configuration and native execution
# ---------------------------------------------------------------------------
# Download directory and other settings live in config.yaml; upstream
# credentials/options are configured in project YAML.
# config.yaml supports ${VARIABLE_NAME} and ${VARIABLE_NAME:-default}
# substitutions. If you add one, define it here and forward it through the
# Compose service's environment.
#
# Native runs do not automatically load .env: export variables in your shell.
# TMPDIR is the standard Unix temporary-directory override; when download_dir
# is omitted, downloads use <system temp directory>/openrepo-sync. It also
# affects other temporary files. The directory must exist and be writable.
# TMPDIR=/tmp
