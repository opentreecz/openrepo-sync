# =============================================================================
# openrepo-sync — Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env && $EDITOR .env
#
# docker compose reads .env automatically. NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — OpenRepo API key
# ---------------------------------------------------------------------------
# Found in the OpenRepo web UI under your user profile, or via:
#   curl -s -H "Authorization: Token <key>" https://repo.example.com/api/whoami
#
# This value is expanded as ${OPENREPO_API_KEY} inside config.yaml.
OPENREPO_API_KEY=
