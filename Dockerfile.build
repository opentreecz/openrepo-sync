# syntax=docker/dockerfile:1
#
# Multi-stage Dockerfile for building openrepo-sync from source.
# Usage:
#   docker compose build
#   docker compose run --rm openrepo-sync --version
#
# No local Rust toolchain is required — everything is compiled inside the
# container. Dependency downloads are cached in a separate layer so that
# subsequent builds after source-only changes complete in ~20-30 seconds.

# ── Stage 1: Build from source ──────────────────────────────────────────
FROM rust:bookworm AS builder

WORKDIR /src

# Copy manifests first for dependency caching
COPY Cargo.toml Cargo.lock ./

# Fetch dependencies in a cacheable layer.
# A dummy main.rs satisfies cargo's requirement for a valid crate root.
# This layer is only invalidated when Cargo.toml or Cargo.lock change.
RUN mkdir src && echo 'fn main(){}' > src/main.rs \
 && cargo fetch \
 && rm -rf src

# Copy actual source and build the release binary
COPY src/ src/

RUN cargo build --release --bin openrepo-sync

# Generate man page from the compiled binary (uses the hidden --generate-man flag)
RUN ./target/release/openrepo-sync --generate-man > /tmp/openrepo-sync.1

# ── Stage 2: Runtime ────────────────────────────────────────────────────
FROM debian:bookworm-slim

LABEL org.opencontainers.image.title="openrepo-sync" \
      org.opencontainers.image.description="Sync packages from upstream sources into an OpenRepo repository" \
      org.opencontainers.image.source="https://github.com/opentreecz/openrepo-sync" \
      org.opencontainers.image.licenses="MIT"

# Install runtime dependencies:
#   ca-certificates  — HTTPS downloads
#   dpkg             — dpkg-deb for direct_url_latest .deb version detection
#   rpm              — rpm -qp  for direct_url_latest .rpm version detection
#   gpg              — InRelease signature verification for deb_repo sources
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      dpkg \
      rpm \
      gpg \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/openrepo-sync /usr/bin/openrepo-sync
COPY --from=builder /tmp/openrepo-sync.1 /usr/share/man/man1/openrepo-sync.1

RUN useradd --system --create-home --shell /usr/sbin/nologin --uid 1000 openrepo

ENV GNUPGHOME=/home/openrepo/.gnupg

USER openrepo

ENTRYPOINT ["/usr/bin/openrepo-sync"]
CMD ["--help"]
