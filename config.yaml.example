# openrepo-sync — global configuration template
#
# Usage:
#   cp config.yaml.example config.yaml
#   $EDITOR config.yaml
#
# config.yaml is your real, secret-bearing config file — never commit it.
# (It is already excluded via .gitignore.)

openrepo:
  # Base URL of your OpenRepo instance. No trailing slash.
  api_url: "https://openrepo.example.com"

  # API token, found in the OpenRepo web UI under your user profile
  # (also returned by GET /api/whoami as the "api_key" field).
  #
  # ${VAR} is expanded from the environment when this file is loaded, so
  # the real secret never has to live in this file or in version control:
  #   export OPENREPO_API_KEY=xxxxx          # shell
  #   echo "OPENREPO_API_KEY=xxxxx" > .env    # docker compose
  api_key: "${OPENREPO_API_KEY}"

# Directory used for temporary package downloads before they are uploaded
# to OpenRepo. Optional — defaults to the system temp dir
# (e.g. /tmp/openrepo-sync). Each file is deleted immediately after a
# successful upload, so this does not need to be a persistent volume,
# even when running in Docker.
# download_dir: "/tmp/openrepo-sync"

# Global architecture policy used by every project and source type.
# Default: amd64.
#
# Common values:
#   amd64  = 64-bit x86 Linux packages; matches amd64, x86_64, x86-64, x64
#   arm64  = 64-bit ARM Linux packages; matches arm64, aarch64, arm-64
#   armhf  = 32-bit ARMv7 Linux packages; matches armhf, armv7, armv7l, armv7hl, arm7
#   i386   = 32-bit x86 Linux packages; matches i386, i486, i586, i686, ia32, x86, 386
#
# Notes:
#   x86 is matched only as a 32-bit architecture token, never inside x86_64/x86-64.
#   x32 is not treated as i386; on Linux it usually means the x32 ABI.
#   Debian "all" packages and RPM "noarch" packages are always accepted.
#
# Use a list to prefer one architecture and fall back to another when upstream
# releases do not publish the preferred architecture.
arch_filter: amd64
# arch_filter: [amd64, arm64]
# arch_filter: []   # disable filename/fixed-URL arch filtering; APT/RPM use their defaults

# Optional scheduler settings used when the container is started with
# `openrepo-sync --schedule` or via `docker compose up -d`.
# Supported interval units: m = minutes, h = hours, d = days.
schedule:
  enabled: true
  interval: "24h"
  run_on_start: true
