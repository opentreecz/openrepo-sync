# Example project file — "sourceforge" source type.
#
# Scrapes a SourceForge project's file listing page to discover releases.
# Files are sorted by detected version number, newest first.
#
# To activate: copy this file into projects/ under its own name, without
# the .example suffix, e.g.:
#   cp projects/sourceforge-example.yaml.example projects/sfpkg.yaml
# Full field reference: docs/sources.md

name: sfpkg
repo_uid: debian-sf
keep_versions: 2
on_conflict: skip          # skip, overwrite, or error (default) when package already exists
# verify_version: true     # verify .deb/.rpm metadata version matches source (default: true)
#                           # set to false to skip verification for this project

source:
  type: sourceforge
  project: my-sf-project      # SourceForge project identifier (from the URL)
  folder: "releases/linux"    # optional; default: root listing (omit for project root)
  filename_filter: "*.deb"    # optional; default: all files (omit to keep all)

  # package_filter — exact package name(s) to sync (optional).
  #
  # Filters files by extracted package name (the part of the filename before
  # the version). Accepts a single string or a list. Omit or set [] to sync all
  # packages. Same behaviour as package_filter in github, deb_repo, and
  # rpm_repo sources.
  #
  # package_filter: my-tool
  # package_filter: [my-tool, my-tool-cli]
